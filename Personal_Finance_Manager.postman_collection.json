              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5000.00,\n  \"date\": \"2024-05-24\",\n  \"category\": \"Salary\",\n  \"description\": \"May Salary\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/transactions", "host": ["{{base_url}}"], "path": ["api", "transactions"] }
          }
        },
        {
          "name": "Get Transactions",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/transactions?startDate=2024-01-01&endDate=2024-12-31", "host": ["{{base_url}}"], "path": ["api", "transactions"], "query": [ { "key": "startDate", "value": "2024-01-01" }, { "key": "endDate", "value": "2024-12-31" } ] }
          }
        }
      ]
    },
    {
