          }
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Side Hustle\",\n  \"type\": \"INCOME\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/categories", "host": ["{{base_url}}"], "path": ["api", "categories"] }
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/api/categories/Side%20Hustle", "host": ["{{base_url}}"], "path": ["api", "categories", "Side%20Hustle"] }
          }
        }
      ]
    },
    {
